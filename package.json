{
  "name": "@mcp-audit-gateway/core",
  "version": "0.8.0",
  "description": "MCP audit and attestation gateway — transparent proxy with cryptographic attestation, policy enforcement, and OTel export",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-audit": "dist/cli.js",
    "mcp-audit-gateway": "dist/cli.js",
    "mcp-diff": "bin/mcp-diff.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest",
    "lint": "eslint src/",
    "c-rec:verify": "tsx test/vectors/c-rec/verify-kat.ts",
    "c-rec:table": "tsx test/vectors/c-rec/harness.ts",
    "c-rec:report": "tsx test/vectors/c-rec/reports/build-comment-payload.ts --write",
    "c-rec:report:check": "tsx test/vectors/c-rec/reports/build-comment-payload.ts > /tmp/c-rec-payload-fresh.md && diff -u test/vectors/c-rec/reports/SEP-3004-comment-payload.md /tmp/c-rec-payload-fresh.md"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gateway",
    "audit",
    "attestation",
    "opentelemetry",
    "proxy",
    "cross-sdk",
    "differential-testing",
    "conformance",
    "interoperability"
  ],
  "author": "Elankumaran Srinivasan",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@noble/ed25519": "^2.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "canonicalize": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^4.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# PHP
RUN apt-get update && apt-get install -y php-cli curl unzip wget apt-transport-https \
    && rm -rf /var/lib/apt/lists/*

# .NET 8 SDK (for C#)
RUN wget -q https://packages.microsoft.com/config/ubuntu/24.04/packages-microsoft-prod.deb -O /tmp/packages-microsoft-prod.deb \
    && dpkg -i /tmp/packages-microsoft-prod.deb \
    && rm /tmp/packages-microsoft-prod.deb \
    && apt-get update \
    && apt-get install -y dotnet-sdk-8.0 \
    && rm -rf /var/lib/apt/lists/*

# dotnet-script tool
RUN dotnet tool install -g dotnet-script
ENV PATH="${PATH}:/root/.dotnet/tools"

# Kotlin (via SDKMAN)
RUN curl -s "https://get.sdkman.io" | bash \
    && bash -c "source /root/.sdkman/bin/sdkman-init.sh && sdk install kotlin 2.0.21"
ENV PATH="${PATH}:/root/.sdkman/candidates/kotlin/current/bin"

WORKDIR /vectors/runners
COPY runners/serialize-sdk-php.php .
COPY runners/serialize-sdk-kotlin.main.kts .
COPY runners/serialize-sdk-csharp.cs .

WORKDIR /vectors
COPY run-remaining.sh .
RUN chmod +x run-remaining.sh

CMD ["/vectors/run-remaining.sh"]

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP Cross-SDK Serialization Test Vectors",
  "description": "Structured test inputs for cross-SDK differential testing. Import this into any SDK's test suite to verify serialization behavior.",
  "version": "1.0.0",
  "reference_implementation": "javascript (Node.js JSON.stringify)",
  "tests": [
    {"id": "float_1e20", "category": "float", "input_type": "number", "input": 1e20, "description": "Large float that exceeds integer notation threshold", "expected_rfc8785": "100000000000000000000"},
    {"id": "float_1e-7", "category": "float", "input_type": "number", "input": 1e-7, "description": "Small negative exponent float", "expected_rfc8785": "1e-7"},
    {"id": "float_0.1+0.2", "category": "float", "input_type": "expression", "expression": "0.1 + 0.2", "description": "Classic floating point imprecision", "expected_rfc8785": "0.30000000000000004"},
    {"id": "float_min_positive", "category": "float", "input_type": "number", "input": 5e-324, "description": "Minimum positive denormalized float", "expected_rfc8785": "5e-324"},
    {"id": "float_max", "category": "float", "input_type": "number", "input": 1.7976931348623157e308, "description": "Maximum representable float", "expected_rfc8785": "1.7976931348623157e+308"},
    {"id": "float_subnormal", "category": "float", "input_type": "number", "input": 2.2250738585072014e-308, "description": "Smallest normal float (DBL_MIN)", "expected_rfc8785": "2.2250738585072014e-308"},
    {"id": "negative_zero", "category": "integer", "input_type": "number", "input": -0.0, "description": "Negative zero (IEEE 754)", "expected_rfc8785": "0"},
    {"id": "int_2pow53_plus1", "category": "integer", "input_type": "integer", "input": 9007199254740993, "description": "Beyond safe integer range (2^53 + 1)", "expected_rfc8785": "9007199254740992", "note": "JavaScript loses precision; other languages preserve"},
    {"id": "int_max_safe", "category": "integer", "input_type": "integer", "input": 9007199254740991, "description": "Maximum safe integer (2^53 - 1)", "expected_rfc8785": "9007199254740991"},
    {"id": "int_negative_large", "category": "integer", "input_type": "integer", "input": -9007199254740991, "description": "Negative max safe integer", "expected_rfc8785": "-9007199254740991"},
    {"id": "control_char_u0001", "category": "string_escaping", "input_type": "object", "input": {"a": "\u0001"}, "description": "Control character U+0001 in object value", "expected_rfc8785": "{\"a\":\"\\u0001\"}"},
    {"id": "control_char_u001f", "category": "string_escaping", "input_type": "object", "input": {"a": "\u001f"}, "description": "Control character U+001F in object value", "expected_rfc8785": "{\"a\":\"\\u001f\"}"},
    {"id": "slash", "category": "string_escaping", "input_type": "string", "input": "a/b", "description": "Forward slash (optional escaping per RFC 8259)", "expected_rfc8785": "\"a/b\""},
    {"id": "backslash", "category": "string_escaping", "input_type": "string", "input": "a\\b", "description": "Backslash (must be escaped)", "expected_rfc8785": "\"a\\\\b\""},
    {"id": "angle_brackets", "category": "string_escaping", "input_type": "string", "input": "<script>", "description": "HTML-sensitive characters", "expected_rfc8785": "\"<script>\""},
    {"id": "ampersand", "category": "string_escaping", "input_type": "string", "input": "a&b", "description": "Ampersand (Go escapes by default)", "expected_rfc8785": "\"a&b\""},
    {"id": "tab_newline", "category": "string_escaping", "input_type": "string", "input": "line1\t\nline2", "description": "Tab and newline (must be escaped)", "expected_rfc8785": "\"line1\\t\\nline2\""},
    {"id": "null_byte", "category": "string_escaping", "input_type": "string", "input": "\u0000", "description": "Null byte (U+0000)", "expected_rfc8785": "\"\\u0000\""},
    {"id": "unicode_nfc", "category": "unicode", "input_type": "string", "input": "caf\u00e9", "description": "NFC-normalized e-acute (U+00E9)", "expected_rfc8785": "\"caf\\u00e9\"", "note": "RFC 8785 requires lowercase hex escape; most serializers pass through raw UTF-8"},
    {"id": "unicode_nfd", "category": "unicode", "input_type": "string", "input": "cafe\u0301", "description": "NFD-normalized combining acute (U+0301)", "expected_rfc8785": "\"cafe\\u0301\""},
    {"id": "unicode_astral", "category": "unicode", "input_type": "string", "input": "\ud83d\ude00", "description": "Astral plane character (U+1F600 grinning face)", "expected_rfc8785": "\"\\ud83d\\ude00\"", "note": "Python uses surrogate pairs in escape; others pass raw UTF-8"},
    {"id": "unicode_bmp_escape", "category": "unicode", "input_type": "string", "input": "\u00a0", "description": "Non-breaking space (U+00A0)", "expected_rfc8785": "\"\\u00a0\""},
    {"id": "unicode_surrogate_pair", "category": "unicode", "input_type": "string", "input": "\ud83d\ude00", "description": "Same as unicode_astral, explicit surrogate pair input", "expected_rfc8785": "\"\\ud83d\\ude00\""},
    {"id": "key_order_ba", "category": "object_structure", "input_type": "object", "input": {"b": 1, "a": 2}, "description": "Object with insertion order b,a (tests key preservation)", "expected_insertion_order": "{\"b\":1,\"a\":2}", "note": "JavaScript V8 re-sorts numeric-string keys"},
    {"id": "key_numeric_strings", "category": "object_structure", "input_type": "object", "input": {"2": "b", "1": "a", "10": "c"}, "description": "Numeric-looking string keys (V8 sorts these as integers)", "expected_insertion_order": "{\"2\":\"b\",\"1\":\"a\",\"10\":\"c\"}", "note": "V8 promotes integer-indexed keys to front in numeric order"},
    {"id": "nested_depth", "category": "object_structure", "input_type": "object", "input": {"a": {"b": {"c": {"d": 1}}}}, "description": "4-level nested objects"},
    {"id": "empty_nested", "category": "object_structure", "input_type": "object", "input": {"a": {}, "b": []}, "description": "Empty object and empty array as values"},
    {"id": "null_value", "category": "mcp_protocol", "input_type": "object", "input": {"name": "tool", "arguments": null}, "description": "Explicit null for arguments field"},
    {"id": "empty_object", "category": "mcp_protocol", "input_type": "object", "input": {"name": "tool", "arguments": {}}, "description": "Empty object for arguments field"},
    {"id": "absent_key", "category": "mcp_protocol", "input_type": "object", "input": {"name": "tool"}, "description": "Arguments key entirely absent"},
    {"id": "isError_false", "category": "mcp_protocol", "input_type": "object", "input": {"content": [], "isError": false}, "description": "Explicit false for isError"},
    {"id": "isError_absent", "category": "mcp_protocol", "input_type": "object", "input": {"content": []}, "description": "isError key absent"},
    {"id": "id_integer", "category": "mcp_protocol", "input_type": "object", "input": {"jsonrpc": "2.0", "id": 1}, "description": "JSON-RPC request with integer ID"},
    {"id": "id_string", "category": "mcp_protocol", "input_type": "object", "input": {"jsonrpc": "2.0", "id": "1"}, "description": "JSON-RPC request with string ID"},
    {"id": "bool_false_vs_null", "category": "boolean_null", "input_type": "object", "input": {"a": false, "b": null, "c": 0, "d": ""}, "description": "All falsy value types in one object"},
    {"id": "empty_string_key", "category": "boolean_null", "input_type": "object", "input": {"": "empty"}, "description": "Empty string as object key"},
    {"id": "array_with_nulls", "category": "boolean_null", "input_type": "array", "input": [1, null, "three", null, 5], "description": "Array with null holes"},
    {"id": "tool_with_schema", "category": "complex", "input_type": "object", "input": {"name": "get_weather", "description": "Get weather for a location", "inputSchema": {"type": "object", "properties": {"location": {"type": "string", "description": "City name"}, "units": {"type": "string", "enum": ["celsius", "fahrenheit"], "default": "celsius"}}, "required": ["location"]}}, "description": "Full MCP tool definition with inputSchema"},
    {"id": "content_array_mixed", "category": "complex", "input_type": "object", "input": {"content": [{"type": "text", "text": "Hello"}, {"type": "image", "data": "base64...", "mimeType": "image/png"}]}, "description": "Mixed content array (text + image)"},
    {"id": "error_response", "category": "complex", "input_type": "object", "input": {"jsonrpc": "2.0", "id": 1, "error": {"code": -32602, "message": "Invalid params", "data": {"param": "missing_field"}}}, "description": "JSON-RPC error response with data"}
  ]
}
